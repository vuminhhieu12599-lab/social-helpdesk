generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
  url      = env("DATABASE_URL")
}

// 1. Bảng Nhân viên/Quản trị viên
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  password     String    
  role         Role      @default(STAFF)
  
  // Các Page do Admin này thêm vào hệ thống
  addedPages   Fanpage[] @relation("PageOwner") 
  
  // Các Page mà tài khoản này ĐƯỢC CẤP QUYỀN trực chat
  managedPages Fanpage[] @relation("PageManagers") 
  
  createdAt    DateTime  @default(now())
}

enum Role {
  ADMIN
  STAFF
}

// 2. Bảng Fanpage (Lưu thông tin kết nối Facebook)
model Fanpage {
  id            String         @id @default(cuid())
  pageId        String         @unique 
  name          String
  accessToken   String         
  
  // Liên kết với Admin đã thêm Page này
  addedBy       User           @relation("PageOwner", fields: [userId], references: [id])
  userId        String
  
  // Danh sách nhân viên được quyền trực Page này
  managers      User[]         @relation("PageManagers") 
  
  conversations Conversation[]
  createdAt     DateTime       @default(now())
}

// 3. Bảng Cuộc hội thoại
model Conversation {
  id           String    @id @default(cuid())
  fanpage      Fanpage   @relation(fields: [fanpageId], references: [id])
  fanpageId    String
  customerId   String    
  customerName String?   
  avatarUrl    String?   // URL ảnh đại diện lấy từ Facebook
  isRead       Boolean   @default(true) // Trạng thái đọc tin nhắn
  messages     Message[]
  tags         Tag[]     
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Tối ưu hóa truy vấn cho việc load danh sách hội thoại
  @@index([fanpageId, updatedAt(sort: Desc)]) 
}

// 4. Bảng Tin nhắn
model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  messageId      String       @unique 
  content        String?
  senderId       String       
  isFromCustomer Boolean      @default(true) 
  createdAt      DateTime     @default(now())
}

// 5. Bảng Thẻ phân loại
model Tag {
  id            String         @id @default(cuid())
  name          String         @unique
  color         String?        
  conversations Conversation[] 
}